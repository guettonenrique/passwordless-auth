{
  "name": "@guettonenrique/passwordless-auth",
  "version": "0.1.5",
  "description": "Passwordless email-OTP authentication: Firebase Cloud Function factories + React Native API and UI. One package, two entries, zero shared runtime deps.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./shared": {
      "import": {
        "types": "./dist/shared/index.d.ts",
        "default": "./dist/shared/index.js"
      },
      "require": {
        "types": "./dist/shared/index.d.cts",
        "default": "./dist/shared/index.cjs"
      }
    },
    "./functions": {
      "import": {
        "types": "./dist/functions/index.d.cts",
        "default": "./dist/functions/index.cjs"
      },
      "require": {
        "types": "./dist/functions/index.d.cts",
        "default": "./dist/functions/index.cjs"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      },
      "default": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guettonenrique/passwordless-auth.git"
  },
  "bugs": {
    "url": "https://github.com/guettonenrique/passwordless-auth/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.functions.json && tsc --noEmit -p tsconfig.react-native.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/auth": "^27.1.0",
    "@react-native-firebase/functions": "^27.1.0",
    "@sendgrid/mail": "^8.1.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.3.1",
    "eslint": "^9.30.0",
    "expo-haptics": "~58.0.7",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "lucide-react-native": "^1.71.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.9",
    "react-test-renderer": "19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
